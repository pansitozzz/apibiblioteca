# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env con credenciales reales al repositorio.

# Perfil activo: dev | docker
SPRING_PROFILES_ACTIVE=dev

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/biblioteca_db
DB_HOST=localhost
DB_NAME=biblioteca_db
DB_USERNAME=biblioteca_user
DB_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-use-a-long-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Reglas de negocio de prestamos y multas
PRESTAMO_DIAS_PLAZO=14
MULTA_MONTO_POR_DIA=2.00

# Servidor
SERVER_PORT=8080
